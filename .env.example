# 监听地址：host 网络模式下必须显式绑定内网 IP，防 0.0.0.0 经 UPnP/DMZ 暴露公网
HOST=127.0.0.1
PORT=3423
TZ=Asia/Shanghai

# Home Assistant（长生命周期令牌：HA 个人页最底部"长期访问令牌"）
HA_URL=http://192.168.0.x:8123
HA_TOKEN=

# 米家极客版中枢网关（不填则极客版半边停采，HA 半边照常）
GATEWAY_URL=http://192.168.0.x
GATEWAY_AUTO_CODE=0        # 预留开关，默认关闭（见设计 §3.3）

# SQLite 路径：开发用本地目录；compose 部署挂 /data 卷时改为 /data/auto-board.db
DB_PATH=./data/auto-board.db
