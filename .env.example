# auto-board 环境配置（复制为 .env 后逐项修改，或直接改 docker-compose.yml 的 environment）
# 监听：host 网络下必须显式写 NAS 内网 IP（禁止 0.0.0.0——防经 UPnP/DMZ 暴露公网，设计 §9）
HOST=<NAS内网IP>
PORT=3423
TZ=Asia/Shanghai

# Home Assistant（两项都留空则 HA 半边停采，极客版不受影响）
HA_URL=http://<HA内网IP>:8123
HA_TOKEN=<HA长期访问令牌>
# HA 长期访问令牌获取：HA → 用户头像 → 安全 → 长期访问令牌 → 创建令牌

# 米家极客版中枢网关（留空则极客版半边停采；登录码不进配置——每次启动后在网页黄条输入，一次性）
GATEWAY_URL=http://<网关内网IP>

# 数据库（挂载卷内，容器重建不丢）
DB_PATH=/app/data/auto-board.db

# 看板访问令牌（可选）：不设则每次启动随机生成并打进容器日志头部
# BOARD_TOKEN=

# 预留（一期未实现自动取码，设计 §4 注明）
# GATEWAY_AUTO_CODE=0
